// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberKind {
  human
  agent
}

enum TaskStage {
  BA
  TA
  Dev
  Review
  Done
}

enum TaskStatus {
  DangLam   @map("Đang làm")
  Cho       @map("Chờ")
  ChoReview @map("Chờ review")
  DangChay  @map("Đang chạy")
  Xong
}

enum MemberStatus {
  DangChay   @map("Đang chạy")
  DangLam    @map("Đang làm")
  DangReview @map("Đang review")
  Cho        @map("Chờ")
}

enum McpServerStatus {
  online
  limited
}

enum SessionResult {
  Xong
  DangChay  @map("Đang chạy")
  ChoReview @map("Chờ review")
  BiChan    @map("Bị chặn")
}

enum CommandResult {
  OK
  ChoReview @map("Chờ review")
  BiChan    @map("Bị chặn")
}

model Project {
  id              String  @id
  code            String
  name            String
  status          String
  desc            String
  currentSprintId String? @unique
  currentSprint   Sprint? @relation("CurrentSprint", fields: [currentSprintId], references: [id], onDelete: SetNull)

  members  ProjectMember[]
  features Feature[]
  docs     Doc[]
  sessions McpSession[]
  sprints  Sprint[]        @relation("ProjectSprints")

  @@map("projects")
}

model Sprint {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation("ProjectSprints", fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  currentFor Project? @relation("CurrentSprint")

  @@index([projectId])
  @@map("sprints")
}

model Member {
  id      String       @id
  name    String
  handle  String
  kind    MemberKind
  role    String
  skills  String[]
  current String
  status  MemberStatus
  /// Chỉ set khi kind = agent: [["Model","claude-opus-4.1"], ...]
  config  Json?
  /// Email Google để đăng nhập — chỉ người (kind = human). Đăng nhập chỉ chấp nhận email có ở đây (ADR-020).
  email   String?      @unique

  skillRows         MemberSkillRow[]
  activity          MemberActivity[]
  projects          ProjectMember[]
  ownedFeatures     Feature[]        @relation("FeatureOwner")
  assignedTasks     Task[]           @relation("TaskAssignee")
  authoredDocs      Doc[]            @relation("DocAuthor")
  docRevisions      DocRevision[]    @relation("RevisionAuthor")
  approvedRevisions DocRevision[]    @relation("RevisionApprover")
  mcpSessions       McpSession[]
  mcpLogEntries     McpLogEntry[]
  authUser          AuthUser?

  @@map("members")
}

model MemberSkillRow {
  id        String @id @default(cuid())
  memberId  String
  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  label     String
  level     String
  percent   Int
  sortOrder Int    @default(0)

  @@map("member_skill_rows")
}

model MemberActivity {
  id       String   @id @default(cuid())
  memberId String
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  icon     String
  text     String
  at       DateTime @default(now())

  @@index([memberId, at(sort: Desc)])
  @@map("member_activity")
}

model ProjectMember {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([projectId, memberId])
  @@map("project_members")
}

model Feature {
  id           String    @id
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  stage        TaskStage
  /// null = feature đã lên kế hoạch nhưng chưa giao cho ai
  ownerId      String?
  owner        Member?   @relation("FeatureOwner", fields: [ownerId], references: [id])
  pct          Int
  /// Kế hoạch cho view Timeline (tuần T1–T8 tính từ ngày bắt đầu sprint hiện tại)
  plannedStart DateTime? @db.Date
  plannedEnd   DateTime? @db.Date

  tasks Task[]
  docs  Doc[]

  @@index([projectId])
  @@map("features")
}

model Task {
  id             String     @id
  featureId      String
  feature        Feature    @relation(fields: [featureId], references: [id], onDelete: Cascade)
  stage          TaskStage
  title          String
  assigneeId     String
  assignee       Member     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  status         TaskStatus
  /// Story point; null = chưa ước lượng (hiển thị "—")
  estimatePoints Int?
  dueDate        DateTime?  @db.Date
  blocked        String?
  blockedFull    String?
  /// Thời điểm agent/người bắt đầu chạy task; null = không chạy
  runningSince   DateTime?

  sessions McpSession[]

  @@index([featureId])
  @@map("tasks")
}

model Doc {
  id           String    @id
  /// "Kho tri thức chung" là theo từng project, nên projectId luôn bắt buộc
  /// dù featureId có thể null (doc không gắn feature nào).
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  featureId    String?
  feature      Feature?  @relation(fields: [featureId], references: [id], onDelete: SetNull)
  title        String
  agentWritten Boolean   @default(false)
  version      String
  status       String
  summary      String
  updatedAt    DateTime  @default(now())
  authorId     String
  author       Member    @relation("DocAuthor", fields: [authorId], references: [id])
  indexedAt    DateTime?
  chunkCount   Int?
  readBy       String[]
  /// Mảng { heading, paras[] } — chỉ hiển thị, không cần query từng đoạn
  sections     Json

  revisions DocRevision[]

  @@index([projectId])
  @@index([featureId])
  @@map("docs")
}

model DocRevision {
  id           String    @id @default(cuid())
  docId        String
  doc          Doc       @relation(fields: [docId], references: [id], onDelete: Cascade)
  authorId     String
  author       Member    @relation("RevisionAuthor", fields: [authorId], references: [id])
  what         String
  createdAt    DateTime  @default(now())
  pending      Boolean   @default(false)
  approvedById String?
  approvedBy   Member?   @relation("RevisionApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  @@index([docId, createdAt(sort: Desc)])
  @@map("doc_revisions")
}

model McpServer {
  id             String          @id
  name           String
  status         McpServerStatus
  url            String
  tools          String[]
  clients        Int
  commandsPerDay Int
  lastCommandAt  DateTime

  @@map("mcp_servers")
}

model McpSession {
  id         String        @id @default(cuid())
  agentId    String
  agent      Member        @relation(fields: [agentId], references: [id])
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id])
  taskId     String?
  task       Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  startedAt  DateTime      @default(now())
  /// null = phiên còn đang chạy; thời lượng tính từ startedAt tới endedAt (hoặc hiện tại)
  endedAt    DateTime?
  toolCalls  Int
  tokensUsed Int           @default(0)
  result     SessionResult

  @@index([projectId])
  @@map("mcp_sessions")
}

model McpLogEntry {
  id      String        @id @default(cuid())
  at      DateTime      @default(now())
  agentId String
  agent   Member        @relation(fields: [agentId], references: [id])
  tool    String
  target  String
  result  CommandResult

  @@index([at(sort: Desc)])
  @@map("mcp_log_entries")
}

// ══════════════ Đăng nhập (Better Auth, ADR-020) ══════════════
// 4 model theo schema lõi của Better Auth 1.7 (user/session/account/verification), đổi tên model qua
// option `modelName` trong lib/auth/auth.ts để không lẫn với Member. Không đổi tên field — adapter
// đọc đúng tên field mặc định.

model AuthUser {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  /// Member (human) khớp email lúc tạo tài khoản — gán trong databaseHooks, không nhận từ client.
  memberId      String        @unique
  member        Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sessions      AuthSession[]
  accounts      AuthAccount[]

  @@map("auth_users")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}
