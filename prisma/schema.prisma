// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RevisionStatus {
  pending
  approved
  rejected
}

enum MemberKind {
  human
  agent
}

enum TaskStage {
  BA
  TA
  Dev
  Review
  Done
}

enum TaskStatus {
  DangLam   @map("Đang làm")
  Cho       @map("Chờ")
  ChoReview @map("Chờ review")
  DangChay  @map("Đang chạy")
  Xong
}

enum MemberStatus {
  DangChay   @map("Đang chạy")
  DangLam    @map("Đang làm")
  DangReview @map("Đang review")
  Cho        @map("Chờ")
}

enum McpServerStatus {
  online
  limited
}

enum SessionResult {
  Xong
  DangChay  @map("Đang chạy")
  ChoReview @map("Chờ review")
  BiChan    @map("Bị chặn")
}

/// Kênh thực hiện chuyển trạng thái task (F22.1)
enum TransitionVia {
  web
  mcp
}

/// Feature agent đề xuất (F16.6) chờ lead duyệt; list chính / timeline chỉ hiện `active`.
enum FeatureStatus {
  proposed
  active
  rejected
}

/// Sự kiện hiện ở activity rail (F17.1)
enum ActivityType {
  task
  doc
  feature
  mcp
}

enum ActivityTone {
  run
  ok
  review
  block
}

enum CommandResult {
  OK
  ChoReview @map("Chờ review")
  BiChan    @map("Bị chặn")
}

model Project {
  id              String    @id
  code            String
  name            String
  status          String
  desc            String
  currentSprintId String?   @unique
  currentSprint   Sprint?   @relation("CurrentSprint", fields: [currentSprintId], references: [id], onDelete: SetNull)
  /// Lưu trữ (F13.7): ẩn khỏi project switcher, hiện mờ ở portfolio. null = đang hoạt động
  archivedAt      DateTime?
  /// Người tạo (F15.4) — được duyệt/sửa tài liệu của dự án như tech lead. null = dự án mẫu / người tạo đã bị xoá
  createdById     String?
  createdBy       Member?   @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members  ProjectMember[]
  features Feature[]
  docs     Doc[]
  sessions McpSession[]
  sprints  Sprint[]        @relation("ProjectSprints")
  events   ActivityEvent[]

  @@map("projects")
}

model Sprint {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation("ProjectSprints", fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  currentFor Project? @relation("CurrentSprint")
  /// Task xếp vào sprint (F21.3)
  tasks      Task[]

  @@index([projectId])
  @@map("sprints")
}

model Member {
  id         String       @id
  name       String
  handle     String
  kind       MemberKind
  role       String
  skills     String[]
  current    String
  status     MemberStatus
  /// CŨ (trước F13.5) — mảng hiển thị [["Model","claude-opus-4.1"], ...]. Không còn đọc/ghi; dữ liệu nằm ở AgentConfig.
  /// Giữ cột để không phải migration xoá dữ liệu; bỏ hẳn sau khi production đã chuyển xong.
  config     Json?
  /// Email Google để đăng nhập — chỉ người (kind = human). Đăng nhập chỉ chấp nhận email có ở đây (ADR-020).
  email      String?      @unique
  /// Quyền quản trị (F15.4, ADR-021): tạo dự án, quản lý thành viên / cấu hình agent / MCP server, duyệt tài liệu.
  /// Cờ riêng, không suy từ `role` (chuỗi tự do — ai tạo thành viên cũng gõ được "Tech lead").
  isTechLead Boolean      @default(false)

  skillRows         MemberSkillRow[]
  activity          MemberActivity[]
  projects          ProjectMember[]
  ownedFeatures     Feature[]        @relation("FeatureOwner")
  assignedTasks     Task[]           @relation("TaskAssignee")
  authoredDocs      Doc[]            @relation("DocAuthor")
  docRevisions      DocRevision[]    @relation("RevisionAuthor")
  approvedRevisions DocRevision[]    @relation("RevisionApprover")
  mcpSessions       McpSession[]
  mcpLogEntries     McpLogEntry[]
  authUser          AuthUser?
  agentConfig       AgentConfig?
  createdProjects   Project[]        @relation("ProjectCreator")
  agentTokens       AgentToken[]
  taskComments      TaskComment[]    @relation("TaskCommentAuthor")
  proposedFeatures  Feature[]        @relation("FeatureProposer")
  activityEvents    ActivityEvent[]  @relation("ActivityActor")
  taskTransitions   TaskTransition[] @relation("TransitionActor")
  criteriaDone      TaskCriterion[]  @relation("CriterionDoneBy")

  @@map("members")
}

enum DocsWritePermission {
  read_only
  append_review
  append_edit_spec
}

/// Cấu hình có cấu trúc của agent (F13.5) — F16 dùng để kiểm tra quyền khi agent gọi MCP.
model AgentConfig {
  memberId            String              @id
  member              Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  model               String
  /// Id/tên MCP server agent được kết nối (vd "meridian-core")
  mcpServers          String[]
  docsWritePermission DocsWritePermission @default(read_only)
  maxConcurrentTasks  Int                 @default(2)
  /// Được gọi tool `features.propose` (BA agent)
  canProposeFeatures  Boolean             @default(false)
  /// Member id các agent mà agent này được giao task cho
  canAssignTo         String[]
  /// Dòng hiển thị khác không dùng để kiểm tra quyền: [["Token tuần này","2.4M"], ...]
  extra               Json?

  @@map("agent_configs")
}

/// Token agent dùng để gọi MCP server (F15.5). Chỉ lưu SHA-256 của token — token gốc hiện một lần lúc tạo.
model AgentToken {
  id         String    @id @default(cuid())
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  /// 4 ký tự cuối để nhận ra token trong danh sách (không đủ để đoán token)
  lastFour   String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  logEntries McpLogEntry[]

  @@index([memberId])
  @@map("agent_tokens")
}

model MemberSkillRow {
  id        String @id @default(cuid())
  memberId  String
  member    Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  label     String
  level     String
  percent   Int
  sortOrder Int    @default(0)

  @@map("member_skill_rows")
}

model MemberActivity {
  id       String   @id @default(cuid())
  memberId String
  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  icon     String
  text     String
  at       DateTime @default(now())

  @@index([memberId, at(sort: Desc)])
  @@map("member_activity")
}

model ProjectMember {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([projectId, memberId])
  @@map("project_members")
}

model Feature {
  id             String        @id
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  stage          TaskStage
  /// null = feature đã lên kế hoạch nhưng chưa giao cho ai
  ownerId        String?
  owner          Member?       @relation("FeatureOwner", fields: [ownerId], references: [id])
  /// CŨ — không còn đọc: % tiến độ tính từ task (F21.2, lib/featureProgress.ts). Giữ cột để không phải migration xoá.
  pct            Int
  /// Kế hoạch cho view Timeline (tuần T1–T8 tính từ ngày bắt đầu sprint hiện tại)
  plannedStart   DateTime?     @db.Date
  plannedEnd     DateTime?     @db.Date
  status         FeatureStatus @default(active)
  /// F16.6: agent đề xuất (features_propose), mô tả / lý do đề xuất, lý do từ chối
  proposedById   String?
  proposedBy     Member?       @relation("FeatureProposer", fields: [proposedById], references: [id], onDelete: SetNull)
  proposal       String?
  proposedAt     DateTime?
  rejectedReason String?

  tasks Task[]
  docs  Doc[]

  @@index([projectId])
  @@map("features")
}

model Task {
  id             String     @id
  featureId      String
  feature        Feature    @relation(fields: [featureId], references: [id], onDelete: Cascade)
  stage          TaskStage
  title          String
  assigneeId     String
  assignee       Member     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  status         TaskStatus
  /// Story point; null = chưa ước lượng (hiển thị "—")
  estimatePoints Int?
  dueDate        DateTime?  @db.Date
  blocked        String?
  blockedFull    String?
  /// Thời điểm agent/người bắt đầu chạy task; null = không chạy
  runningSince   DateTime?
  /// Liên kết code (F22.4) — agent báo qua MCP `tasks_update_status`, người nhập tay ở drawer
  prUrl          String?
  branch         String?
  commitSha      String?
  /// Sprint task thuộc về (F21.3); null = chưa xếp sprint. Xoá sprint → task về "chưa xếp".
  sprintId       String?
  sprint         Sprint?    @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  sessions    McpSession[]
  comments    TaskComment[]
  transitions TaskTransition[]
  criteria    TaskCriterion[]

  @@index([featureId])
  @@index([sprintId])
  @@map("tasks")
}

/// Lịch sử chuyển stage / trạng thái task (F22.1) — nền cho cổng review (F22.2), chỉ số chất lượng (F22.5), effort (F23.5).
/// Mỗi dòng là một lần đổi; from* null = task vừa tạo. Chỉ ghi phần thay đổi (stage hoặc status hoặc cả hai).
model TaskTransition {
  id         String        @id @default(cuid())
  taskId     String
  task       Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId    String
  actor      Member        @relation("TransitionActor", fields: [actorId], references: [id], onDelete: Cascade)
  fromStage  TaskStage?
  toStage    TaskStage?
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  via        TransitionVia
  /// Lý do kèm theo (F22.2: lý do trả lại khi review)
  note       String?
  at         DateTime      @default(now())

  @@index([taskId, at])
  @@map("task_transitions")
}

/// Acceptance criteria của task (F21.6) — checklist người / agent tick; nền cho Definition of Done (F22.3).
model TaskCriterion {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  /// Thứ tự hiển thị (tăng dần)
  position  Int
  /// null = chưa đạt
  doneAt    DateTime?
  doneById  String?
  doneBy    Member?   @relation("CriterionDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())

  @@index([taskId, position])
  @@map("task_criteria")
}

/// Bình luận trên task (F16.4) — agent ghi qua MCP `tasks_comment`, hiện ở mục "Bình luận" của task drawer.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    Member   @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model Doc {
  id           String    @id
  /// "Kho tri thức chung" là theo từng project, nên projectId luôn bắt buộc
  /// dù featureId có thể null (doc không gắn feature nào).
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  featureId    String?
  feature      Feature?  @relation(fields: [featureId], references: [id], onDelete: SetNull)
  title        String
  agentWritten Boolean   @default(false)
  version      String
  status       String
  summary      String
  updatedAt    DateTime  @default(now())
  authorId     String
  author       Member    @relation("DocAuthor", fields: [authorId], references: [id])
  indexedAt    DateTime?
  chunkCount   Int?
  readBy       String[]
  /// Mảng { heading, paras[] } — chỉ hiển thị, không cần query từng đoạn
  sections     Json

  revisions DocRevision[]

  @@index([projectId])
  @@index([featureId])
  @@map("docs")
}

model DocRevision {
  id               String         @id @default(cuid())
  docId            String
  doc              Doc            @relation(fields: [docId], references: [id], onDelete: Cascade)
  authorId         String
  author           Member         @relation("RevisionAuthor", fields: [authorId], references: [id])
  what             String
  createdAt        DateTime       @default(now())
  /// pending = chờ duyệt; approved = đã áp vào bản chính (F12.2); rejected = bị từ chối (F12.3)
  status           RevisionStatus @default(pending)
  /// Nội dung đề xuất — null = giữ nguyên phần đó của tài liệu. Cùng shape với Doc.summary / Doc.sections.
  proposedSummary  String?
  proposedSections Json?
  rejectedReason   String?
  /// Doc.version lúc tạo revision — F12.2 từ chối duyệt nếu tài liệu đã đổi version (tránh ghi đè)
  baseVersion      String
  approvedById     String?
  approvedBy       Member?        @relation("RevisionApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?

  @@index([docId, createdAt(sort: Desc)])
  @@map("doc_revisions")
}

/// Sự kiện thật của dự án (F17.1) — activity rail "Agent đang làm gì" đọc bảng này; ghi từ server action và MCP tool.
/// taskId/docId/featureId là chuỗi (không FK): sự kiện giữ lịch sử kể cả khi đối tượng bị xoá.
model ActivityEvent {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String
  actor     Member       @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  type      ActivityType
  taskId    String?
  docId     String?
  featureId String?
  text      String
  /// Tool MCP dạng hiển thị (`tasks.claim`); null = thao tác trên web
  tool      String?
  tone      ActivityTone
  at        DateTime     @default(now())

  @@index([projectId, at(sort: Desc)])
  @@map("activity_events")
}

model McpServer {
  id             String          @id
  name           String
  status         McpServerStatus
  url            String
  tools          String[]
  clients        Int
  commandsPerDay Int
  /// null = chưa nhận lệnh nào (server vừa đăng ký, F13.6)
  lastCommandAt  DateTime?

  @@map("mcp_servers")
}

model McpSession {
  id         String        @id @default(cuid())
  agentId    String
  agent      Member        @relation(fields: [agentId], references: [id])
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id])
  taskId     String?
  task       Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  startedAt  DateTime      @default(now())
  /// null = phiên còn đang chạy; thời lượng tính từ startedAt tới endedAt (hoặc hiện tại)
  endedAt    DateTime?
  toolCalls  Int
  tokensUsed Int           @default(0)
  result     SessionResult
  /// Lệnh MCP cuối (F16.2) — phiên do endpoint thật tạo; quá 30 phút không có lệnh → đóng. null = dữ liệu mẫu
  lastCallAt DateTime?

  @@index([projectId])
  @@map("mcp_sessions")
}

model McpLogEntry {
  id      String        @id @default(cuid())
  at      DateTime      @default(now())
  agentId String
  agent   Member        @relation(fields: [agentId], references: [id])
  tool    String
  target  String
  result  CommandResult
  /// Token agent đã dùng (F16.7, FR-AG-08) — rate limit đếm theo token. null = dữ liệu mẫu / token đã xoá
  tokenId String?
  token   AgentToken?   @relation(fields: [tokenId], references: [id], onDelete: SetNull)

  @@index([at(sort: Desc)])
  @@index([tokenId, at])
  @@map("mcp_log_entries")
}

// ══════════════ Đăng nhập (Better Auth, ADR-020) ══════════════
// 4 model theo schema lõi của Better Auth 1.7 (user/session/account/verification), đổi tên model qua
// option `modelName` trong lib/auth/auth.ts để không lẫn với Member. Không đổi tên field — adapter
// đọc đúng tên field mặc định.

model AuthUser {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  /// Member (human) khớp email lúc tạo tài khoản — gán trong databaseHooks, không nhận từ client.
  memberId      String        @unique
  member        Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sessions      AuthSession[]
  accounts      AuthAccount[]

  @@map("auth_users")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("auth_accounts")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verifications")
}
