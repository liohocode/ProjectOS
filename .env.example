DATABASE_URL="postgresql://meridian:meridian@localhost:5432/meridian"
DATABASE_URL_TEST="postgresql://meridian:meridian@localhost:5432/meridian_test"

# Đăng nhập (F15.2, ADR-020) — hướng dẫn: docs/guides/google-oauth.md
# Secret ký session: tạo bằng `openssl rand -base64 32`. Bắt buộc ở production (Better Auth từ chối chạy nếu thiếu).
BETTER_AUTH_SECRET=""
# URL gốc của app — callback OAuth và kiểm tra origin dựa vào đây.
BETTER_AUTH_URL="http://localhost:3000"
# OAuth client "Web application" trên Google Cloud (cùng project với Cloud Run). Để trống → nút đăng nhập bị khoá.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Chỉ dev: email Google thật của bạn — `npx prisma db seed` gán cho tech lead mẫu (Trung Hiếu) để đăng nhập thử.
DEV_LOGIN_EMAIL=""
